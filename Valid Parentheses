
import java.util.Stack;

class Solution {
    public boolean isValid(String s) {

        Stack<Character> stack = new Stack<>();

        for (char c : s.toCharArray()) {

            // If it's an opening bracket, push it
            if (c == '(' || c == '{' || c == '[') {
                stack.push(c);
            }

            // Otherwise, it must be a closing bracket
            else {
                // No opening bracket to match it
                if (stack.isEmpty()) {
                    return false;
                }

                char top = stack.pop();

                // Check whether the bracket types match
                if (c == ')' && top != '(') {
                    return false;
                }

                if (c == '}' && top != '{') {
                    return false;
                }

                if (c == ']' && top != '[') {
                    return false;
                }
            }
        }

        // All opening brackets must have been closed
        return stack.isEmpty();
    }
}
